};
function realiseCheck(card,me){
  if(card.gate && card.gate.everyColor){
    if(hasCompleteSet(me)){
      showAction(`<div class="rmeta">Center · ready to give</div><div class="hint">Your completed set qualifies you to enter giving status. This is not an individual victory.</div><button class="btn" onclick="enterCenterNow()">Enter giving status</button>`);
    }else{
      showAction(`<div class="rmeta">Center · not yet ready</div><div class="hint">You need your complete set: three Level 2 tokens and one Level 1 token, all with their required cards.</div><button class="btn ghost" onclick="endTurn()">End turn</button>`);
    }
    return;
  }
  if(card.realised){showAction(`<div class="rmeta">essential ${roman(card.enum)} · already realised</div><div class="hint">This one’s been taken. Its token is in play.</div><button class="btn ghost" onclick="endTurn()">End turn</button>`);return;}
  const is3 = THREE_COLORS.includes(card.color);
  const chk=canRealise(me,card);
  if(chk.ok){
    if(is3){
      const from=card.gate.fromFour;
      showAction(`<div class="rmeta" style="color:var(--accent)">essential ${roman(card.enum)} — convert to ${cat(card.color)}</div>
        ${optionalQuestion(CONTENT.essentialQuestions[card.enum])}
        <div class="hint">You hold ${chk.why}. Converting <b>transcends your ${cat(from)} 4</b> into a ${cat(card.color)} 3: the 4’s cards <b>release</b> (available in your hand), the Level 1 token remains within Level 2, and two suit cards complete the new token.</div>
        <button class="btn" onclick="convert(${card.enum})">Create Level 2 token</button>`);
    }else{
      showAction(`<div class="rmeta" style="color:var(--accent)">essential ${roman(card.enum)} — complete a ${cat(card.color)} 4-token</div>
        ${optionalQuestion(CONTENT.essentialQuestions[card.enum])}
        <div class="hint">You hold ${chk.why}. Realising binds 4 cards into a <b>${cat(card.color)}</b> Level 1 token.</div>
        <button class="btn" onclick="realiseFour(${card.enum})">Create Level 1 token</button>`);
    }
  }else{
    showAction(`<div class="rmeta">essential ${roman(card.enum)} — not yet</div>
      <div class="hint">You’re standing on it, but ${chk.why} You take up the space without making anything of it.</div>
      <button class="btn ghost" onclick="endTurn()">End turn</button>`);
  }
}
window.enterCenterNow=function(){
  const me=players[turn];
  const card=board[me.pos.r]&&board[me.pos.r][me.pos.c];
  if(!card||!card.gate||!card.gate.everyColor||!hasCompleteSet(me)){endTurn();return;}
  enterExhale(me);endTurn();
};
function canRealise(me,ess){
  if(ess.gate.everyColor){
    const have=new Set(tokenColors(me));const missing=NEED_TOKEN_COLORS.filter(c=>!have.has(c));
    return missing.length?{ok:false,why:`the center requires all six categories — missing ${missing.map(cat).join(", ")}.`}:{ok:true,why:"all six required categories"};
  }
  const have={};me.hand.forEach(c=>have[c.suit]=(have[c.suit]||0)+1);
  const need={};ess.gate.suits.forEach(s=>need[s]=(need[s]||0)+1);
  let ok=true;const parts=[];
  for(const[s,n]of Object.entries(need)){parts.push(`${n}${GLY[s]}`);if((have[s]||0)<n)ok=false;}
  const is3=THREE_COLORS.includes(ess.color);
  if(!ok)return{ok:false,why:`it needs ${parts.join(" + ")} loose in your hand${is3?` and a ${cat(ess.gate.fromFour)} 4-token to convert`:""}.`};
  if(is3){
    const hasFour=me.tokens.some(t=>t.kind==='four'&&t.color===ess.gate.fromFour);
    if(!hasFour)return{ok:false,why:`it needs a ${cat(ess.gate.fromFour)} 4-token to convert (you must hold the 4 first).`};
    return{ok:true,why:`${parts.join(" + ")} and a ${cat(ess.gate.fromFour)} 4-token to convert`};
  }
  return{ok:true,why:parts.join(" + ")};
}
/* take exactly the required cards out of hand; return them as an array */
function takeCards(me,suitsMultiset){
  const need={};suitsMultiset.forEach(s=>need[s]=(need[s]||0)+1);
  const taken=[];
  for(const [s,n] of Object.entries(need)){
    let got=0;
    me.hand=me.hand.filter(c=>{ if(c.suit===s&&got<n){got++;taken.push(c);return false;} return true; });
  }
  return taken;
}
window.realiseFour=function(enumIdx){
  const me=players[turn];const card=board[me.pos.r][me.pos.c];
  card.realised=true;
  const cards=takeCards(me,card.gate.suits);
  me.tokens.push({kind:'four', color:card.color, cards, freed:[], requiredSuits:[...card.gate.suits], essentialId:card.enum});
  log(`<b >${me.name}</b> realised a <span style="color:var(--ink-faint)">${cat(card.color)}</span> 4 (4 cards bound)`);
  maybeEnterCenter(me);

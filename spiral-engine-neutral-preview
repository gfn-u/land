};
window.convert=function(enumIdx){
  const me=players[turn];const card=board[me.pos.r][me.pos.c];
  card.realised=true;
  const from=card.gate.fromFour;
  // find the four-token being transcended
  const fi=me.tokens.findIndex(t=>t.kind==='four'&&t.color===from);
  const four=me.tokens.splice(fi,1)[0];
  // RELEASE the 4's cards, by density
  me.hand.push(...four.cards); // all modes: the four suit cards become available again
  const releasedTo = 'your hand';
  // take 2 fresh cards to ground the new 3
  const twoCards=takeCards(me,card.gate.suits);
  // the four becomes a FREED token nested inside the three
  const freedToken={kind:'freed', color:four.color, cards:[], freed:[], requiredSuits:four.requiredSuits, essentialId:four.essentialId};
  me.tokens.push({kind:'three', color:card.color, cards:twoCards, freed:[freedToken], requiredSuits:[...card.gate.suits], essentialId:card.enum});
  log(`<b >${me.name}</b> converted a ${cat(from)} 4 into a <span style="color:var(--ink-faint)">${cat(card.color)}</span> 3 — 4-cards released to ${releasedTo}, the 4 rides inside as a freed token`);
  maybeEnterCenter(me);

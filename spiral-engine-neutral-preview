/* ---- reachability & reserve state ---- */
function reservedBy(r,c){for(const p of players)if(p.reserves.some(x=>x.r===r&&x.c===c))return p;return null;}
function cheb(from,to){return Math.max(Math.abs(from.r-to.r),Math.abs(from.c-to.c));}

/* Is (to) a *legal landing* given density and roll?
   spacious/open: exactly N king-steps. dense: up to N (die is a maximum). */
function isLegalLanding(from,to,n){
  const v=board[to.r] && board[to.r][to.c];
  if(!v || v==='BELOW') return false; // empty or the lower half of an essential — not a landing cell
  const d=cheb(from,to);
  if(d===0) return pace==='dense';
  return pace==='dense' ? (d<=n) : (d===n);
}

/* resolve a cell to its real card, following BELOW markers up to the essential */
function cardAt(r,c){
  const v=board[r] && board[r][c];
  if(v==='BELOW'){ // the essential is directly above (or higher) in this column
    for(let rr=r-1; rr>=0; rr--){ if(board[rr][c] && board[rr][c]!=='BELOW') return {card:board[rr][c], r:rr, c}; }
    return {card:null,r,c};
  }
  return {card:v||null, r, c};
}
/* Is (to) a *sensible* move — one that advances the current player? */
function isSensible(to){
  const me=players[turn];
  const {card}=cardAt(to.r,to.c);
  if(!card) return false;
  if(me.centered){
    return me.reserves.some(x=>x.r===to.r&&x.c===to.c);
  }
  if(card.type==='perspective'){
    return !reservedBy(to.r,to.c);
  }
  return !card.realised && canRealise(me,card).ok;
}

/* The set of cells to LIGHT for the current player, by density. */
function highlightCells(){
  const me=players[turn];
  const legal=[];
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(isLegalLanding(me.pos,{r,c},die)) legal.push({r,c});
  }
  if(pace==='spacious'){
    const sensible=legal.filter(({r,c})=>isSensible({r,c}));
    // if nothing sensible is reachable, fall back to showing all legal (don't strand the player)
    return sensible.length?sensible:legal;
  }
  return legal; // open + dense: all legal landings (dense includes up-to-N and stay-put)
}


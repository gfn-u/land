    const isEss=card.type==='essential';
    if(isEss){ cell.style.gridRow=`${r+1} / span 2`; } // essentials 2 rows tall
    cell.className='cell '+(isEss?'essential':'perspective');
    const isCenter=card.color==='rainbow';

}
function tokenSlots(p){
  // six colour floor. A colour is 'present' if held as a token OR as a freed token inside a three.
  // grounded (solid) vs dormant (dashed). Then the gift slot (unconverted 4). Then the loose hand.
  const present={}; // color -> {grounded:bool}
  p.tokens.forEach(t=>{
    const g=tokenGrounded(t);
    present[t.color]=present[t.color]||{grounded:false}; if(g)present[t.color].grounded=true; else if(!(t.color in present))present[t.color]={grounded:false};
    if(t.kind==='three'&&t.freed&&t.freed[0]){ const fc=t.freed[0].color; present[fc]=present[fc]||{grounded:true}; present[fc].grounded=true; }
  });
  let h='<div class="tokrow">';
  NEED_TOKEN_COLORS.forEach(c=>{
    const st=present[c];
    if(st&&st.grounded) h+=`<span class="tok" style="background:${fill(c)}" title="${cat(c)} · grounded"></span>`;
    else if(st) h+=`<span class="tok dormant" style="border-color:${fill(c)}" title="${cat(c)} · dormant, needs cards"></span>`;
    else h+=`<span class="tok empty-slot" title="need ${cat(c)}"></span>`;
  });
  // gift: an unconverted 4-token
  const gift=p.tokens.find(t=>t.kind==='four');
  h+=`<span class="tokgap"></span>`;
  if(gift) h+=`<span class="tok gift ${tokenGrounded(gift)?'':'dormant'}" style="background:${tokenGrounded(gift)?fill(gift.color):'transparent'};border-color:${fill(gift.color)}" title="gift · ${cat(gift.color)} 4"></span>`;
  else h+=`<span class="tok empty-slot gift" title="your gift (an unconverted 4)"></span>`;
  h+='</div>';
  // loose hand
  if(p.hand.length){
    const kinds={}; p.hand.forEach(cd=>{const k=cd.suit+'|'+cd.color;kinds[k]=(kinds[k]||0)+1;});
    let cards='<div class="handrow">';
    Object.entries(kinds).forEach(([k,n])=>{const[s,col]=k.split('|');
      cards+=`<span class="hcard" style="background:${fill(col)};color:${txt(col)}" title="${s} ${col}${n>1?` ×${n}`:''}">${GLY[s]}${n>1?`<sub>${n}</sub>`:''}</span>`;});
    cards+='</div>';
    h+=cards;
  }
  return h;
}
function completionSpiral(p){
  // the fun moment: a closing spiral drawn when a player has fully won
  const cx=17,cy=17,turns=2.2, N=NEED_TOKEN_COLORS.length, ptsPer=9;
  const order=["infrared","magenta","amber","orange","green","teal"];
  let paths='';
  for(let i=0;i<N;i++){
    const color=order[i];let d='';
    for(let j=0;j<=ptsPer;j++){
      const t=(i*ptsPer+j)/(N*ptsPer);const ang=t*turns*2*Math.PI;const rad=2+t*13;
      const x=cx+rad*Math.cos(ang),y=cy+rad*Math.sin(ang);
      d+=(j===0?'M':'L')+x.toFixed(1)+' '+y.toFixed(1)+' ';
    }
    paths+=`<path d="${d}" fill="none" stroke="${fill(color)}" stroke-width="3" stroke-linecap="round"/>`;
  }
  return `<svg class="pspiral done" width="36" height="36" viewBox="0 0 34 34">${paths}</svg>`;
}

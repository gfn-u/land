}
function enterExhale(me){
  if(!hasCompleteSet(me))return;
  me.centered=true;me.freed=true;
  log(`<b>${me.name}</b> reached the center with a complete set and may now give.`);
}

/* ---- EXHALE: giving. Must occupy one of YOUR reserved spaces to give. ---- */
function arriveGiving(r,c,card){
  const me=players[turn];
  const onMyReserve = me.reserves.some(x=>x.r===r&&x.c===c);
  if(!onMyReserve){
    showAction(`<div class="hint">To give, journey back to and land on <b>one of your own reserved spaces</b> (your reservation marker). You’re not on one now.</div>
      <button class="btn ghost" onclick="endTurn()">End turn</button>`);
    return;
  }
  const others=players.filter(p=>p.id!==me.id);
  const recOpts=others.map(p=>`<option value="${p.id}">Player ${p.name} — ${p.tokens.length} tok${dormantCount(p)?`, ${dormantCount(p)} dormant`:''}</option>`).join('');

  // giveable: whole tokens (a freed token, or a spare grounded token) and loose hand cards
  const giftOpts=[];
  me.tokens.forEach((t,i)=>{
    const label = t.kind==='three' ? `3 · ${cat(t.color)} (carries ${t.freed[0]?cat(t.freed[0].color):'?'})`
                : t.kind==='four'  ? `4 · ${cat(t.color)}`
                : `freed · ${cat(t.color)}`;
    giftOpts.push(`<option value="tok:${i}">token · ${label}</option>`);
  });
  const handKinds={}; me.hand.forEach(cd=>{const k=cd.suit+'|'+cd.color;handKinds[k]=(handKinds[k]||0)+1;});
  Object.entries(handKinds).forEach(([k,n])=>{const[s,col]=k.split('|');giftOpts.push(`<option value="card:${k}">suit card · ${GLY[s]} ${cat(col)}${n>1?` ×${n}`:''}</option>`);});

  if(!giftOpts.length){
    showAction(`<div class="hint">Nothing to give from here — end turn.</div><button class="btn ghost" onclick="endTurn()">End turn</button>`);
    return;
  }
  showAction(`<div class="rmeta">give from this reserve</div>
    <div class="hint">Choose what to give and who receives it. A gifted <b>token can arrive dormant</b> until the receiver holds the cards needed to ground it. </div>
    <div style="margin-top:.5rem;font-size:.8rem;color:var(--ink-faint)">Give</div>
    <select class="giftsel" id="giftWhat">${giftOpts.join('')}</select>
    <div style="margin-top:.4rem;font-size:.8rem;color:var(--ink-faint)">to</div>
    <select class="giftsel" id="giftTo">${recOpts}</select>
    <button class="btn" onclick="giveTo(${r},${c})">Pass it over</button>`);
}
/* after any transfer, try to (re)ground a receiver's dormant three/four from their hand */
function groundFromHand(p){
  for(const t of p.tokens){
    if(tokenGrounded(t)) continue;
    const need = t.kind==='four'?4:2;
    // simplest grounding: consume matching-suit cards — use its constellation if known, else any cards
    const cons = t.requiredSuits || tokenConstellation(t.color);
    const req={}; (cons.length?cons:[]).forEach(s=>req[s]=(req[s]||0)+1);
    const have={}; p.hand.forEach(c=>have[c.suit]=(have[c.suit]||0)+1);
    const ok = cons.length ? Object.entries(req).every(([s,n])=>(have[s]||0)>=n) : (p.hand.length>=need);
    if(ok){
      const taken = cons.length ? takeCards(p,cons) : p.hand.splice(0,need);
      t.cards = (t.cards||[]).concat(taken);
    }
  }
}
window.giveTo=function(r,c){
  const me=players[turn];
  const what=document.getElementById('giftWhat').value;
  const rec=players.find(p=>p.id===parseInt(document.getElementById('giftTo').value,10));
  if(what.startsWith('tok:')){
    const i=parseInt(what.slice(4),10);
    const t=me.tokens.splice(i,1)[0];
    // The token transfers independently; its attached suit cards stay with the giver.
    me.hand.push(...(t.cards||[])); // the giver retains the cards previously attached to the token
    const gift={kind:t.kind,color:t.color,cards:[],freed:t.freed||[],requiredSuits:t.requiredSuits,essentialId:t.essentialId};
    rec.tokens.push(gift);
    log(`<b >${me.name}</b> gave a ${t.kind} <span style="color:var(--ink-faint)">${cat(t.color)}</span> token to <b >${rec.name}</b>${t.kind==='freed'?' (freed — needs no grounding)':' — dormant until grounded'}`);
    groundFromHand(rec);
  }else{
    const [s,col]=what.slice(5).split('|');
    const idx=me.hand.findIndex(cd=>cd.suit===s&&cd.color===col);
    if(idx>=0){ const cd=me.hand.splice(idx,1)[0]; rec.hand.push(cd); }
    log(`<b >${me.name}</b> gave a ${GLY[s]} <span style="color:var(--ink-faint)">${cat(col)}</span> card to <b >${rec.name}</b>`);
    groundFromHand(rec);
  }
  updateGivingEligibility(me);
  // giving from a reserve frees that board space
  me.reserves=me.reserves.filter(x=>!(x.r===r&&x.c===c));
  rec.reserves.push({r,c});
  window._giving=null;
  renderPlayers();
  checkWin();
  if(!gameOver)endTurn();
};

/* ---- win ---- */
function checkWin(){
  if(players.every(hasCompleteSet)){
    gameOver=true;
    const gifts=players.map(p=>{const f=p.tokens.find(t=>t.kind==='four');return f?cat(f.color):'—';});
    showAction(`<div class="rq" style="font-size:1.2rem">All three players have completed the shared objective.</div>
      <div class="hint">Each carries all six required categories through three integrations, plus a single distinct gift (${gifts.join(", ")}). All three players have completed the required tokens and retained their individual gift. Everyone wins.</div>`,'win');
    document.getElementById('action').classList.add('win');
    dieBtn.disabled=true;
    log(`<b>All three complete. Everyone wins.</b>`);
    renderPlayers();
  }
}

/* ---- turn plumbing ---- */
function showAction(html,cls){actionEl.className='action show'+(cls?(' '+cls):'');actionEl.innerHTML=html;}
window.endTurn=function(){
  actionEl.className='action';actionEl.innerHTML='';
  die=null;dieNum.textContent='';dieBtn.disabled=false;awaitingMove=false;
  totalTurns++;
  if(!gameOver){turn=(turn+1)%players.length;}
  renderAll();
};


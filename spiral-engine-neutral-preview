<script>
/* ================= SPIRAL ENGINE — CONTENT-BLIND =================
   The engine works without any questions.
   OPTIONAL CONTENT: Add text to the two question maps below.
   Keys for perspective cards are their unique IDs (e.g. "spades-red-0").
   Keys for essentials are numeric IDs 0–21.
   Leave an entry absent or blank to play without a question.
   Do not change suit IDs, constellation data, or movement logic to customize copy.
*/
const CONTENT = {
  perspectiveQuestions: {},
  essentialQuestions: {}
};
function optionalQuestion(text){
  return typeof text === "string" && text.trim()
    ? `<div class="rq">${escapeHtml(text)}</div>` : "";
}
function escapeHtml(text){
  return String(text).replace(/[&<>"']/g, ch=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[ch]);
}
function roman(n){
  if(n===0)return "0";
  const pairs=[[10,"X"],[9,"IX"],[5,"V"],[4,"IV"],[1,"I"]];
  let result="";
  for(const [value,glyph] of pairs){while(n>=value){result+=glyph;n-=value;}}
  return result;
}

const SPECTRUM=["infrared","magenta","red","amber","orange","green","teal","turquoise","purple","rainbow"];
const CV={infrared:"#f7f4ec",magenta:"#e7ded0",red:"#d5c7b3",amber:"#c2ad93",orange:"#ac9278",green:"#8d7765",teal:"#6e5e53",turquoise:"#4e4640",purple:"#292725"};
const CATEGORY_MARKS=["●","◐","◆","▲","■","✚","✦","⬡","✳"];
const CATEGORY=Object.fromEntries(SPECTRUM.slice(0,9).map((c,i)=>[c,{id:`S${i+1}`,mark:CATEGORY_MARKS[i]}]));
function cat(c){return CATEGORY[c]?`${CATEGORY[c].mark} ${CATEGORY[c].id}`:"◎ center";}
function catMark(c){return CATEGORY[c]?.mark||"◎";}
function fill(c){return c==='rainbow'?'':CV[c];}
function txt(c){
  if(c==='rainbow')return '#fff';
  const hex=CV[c].slice(1);
  const rgb=[0,2,4].map(i=>parseInt(hex.slice(i,i+2),16)/255);
  const light=rgb.map(v=>v<=.04045?v/12.92:Math.pow((v+.055)/1.055,2.4));
  const lum=.2126*light[0]+.7152*light[1]+.0722*light[2];
  return lum>.32?'#292725':'#fff';
}

/* Two axes orient four quadrants of inquiry. The quadrant labels are
   retained; the playing cards use familiar suits. Suit correspondence:
   The original four quadrant IDs map to spades, hearts, clubs, and diamonds.
   This is a naming change, not a change to the game structure. */
const AXES={a:["differentiation","integration"],b:["contraction","expansion"]};
const QUADRANTS=[
  {id:0,coord:[-1,-1],label:"I",  suit:"spades",   glyph:"♠"},
  {id:1,coord:[+1,-1],label:"WE", suit:"hearts",   glyph:"♥"},
  {id:2,coord:[-1,+1],label:"IT", suit:"clubs",    glyph:"♣"},
  {id:3,coord:[+1,+1],label:"ITS",suit:"diamonds", glyph:"♦"},
];
const SUITS=QUADRANTS.map(q=>q.suit);
const GLY=Object.fromEntries(QUADRANTS.map(q=>[q.suit,q.glyph]));
const SUIT_COLOR_COUNTS={magenta:2,red:2,orange:2,amber:2,green:2,teal:1,turquoise:1,purple:1};
const ESSENTIAL_COLORS={teal:4,green:4,orange:4,infrared:3,magenta:3,amber:3}; // 12 fours + 9 threes
const FOUR_COLORS=["teal","green","orange"];   // the 4-essential colours (convertible / gift)
const THREE_COLORS=["infrared","magenta","amber"];  // the 3-essential colours (converted from a 4)
const NEED_TOKEN_COLORS=[...new Set(Object.keys(ESSENTIAL_COLORS))]; // the six essential colours
/* which 4 each 3 transcends (the freed token nested inside the 3):
     infrared <- teal   (both home I / spades)
     magenta  <- orange (both home ITS / diamonds)
     amber    <- green  (both home WE / hearts)
   Note: IT (clubs) anchors NO chain — it only ever supports. This asymmetry is
   emergent from the data, not named by the engine. Red stays a perspective-card
   colour only; the grounded 3-essential is infrared (below red on the spectrum). */
const THREE_FROM_FOUR={ infrared:"teal", magenta:"orange", amber:"green" };

/* ===== CONSTELLATIONS (suit requirements) =====
   Each 4 = a list of 4 iterations (unique suit-multisets, 4 cards each).
   Each 3 = a list of 3 iterations; each is {from: <four-colour>, cards: <2-card multiset>}.
   A player may satisfy an essential by ANY one of its iterations. */
const CONSTELLATIONS = {
  teal:   [ ["spades","spades","spades","spades"], ["clubs","clubs","clubs","spades"], ["spades","spades","spades","clubs"], ["clubs","clubs","clubs","clubs"] ],
  orange: [ ["diamonds","diamonds","clubs","clubs"], ["diamonds","diamonds","diamonds","clubs"], ["diamonds","diamonds","diamonds","hearts"], ["diamonds","diamonds","diamonds","diamonds"] ],
  green:  [ ["hearts","hearts","diamonds","diamonds"], ["hearts","hearts","hearts","clubs"], ["hearts","hearts","hearts","spades"], ["hearts","hearts","hearts","hearts"] ],
  infrared: [ {from:"teal", cards:["spades","diamonds"]},  {from:"teal", cards:["clubs","diamonds"]}, {from:"teal", cards:["hearts","spades"]} ],
  magenta:[ {from:"orange", cards:["spades","hearts"]}, {from:"orange", cards:["spades","diamonds"]}, {from:"orange", cards:["clubs","diamonds"]} ],
  amber:  [ {from:"green", cards:["hearts","spades"]},  {from:"green", cards:["clubs","diamonds"]}, {from:"green", cards:["clubs","hearts"]} ],
};

/* TOKEN MODEL
   A token is {kind, color, cards:[...], freed:[...]}
   - kind 'four'  : a realised 4-essential. grounded by 4 cards (cards.length===4).
   - kind 'three' : a converted 3-essential. grounded by 2 cards, and carries ONE freed
                    token inside (freed[0]) — the transcended 4, grounded by nothing.
   - kind 'freed' : a token grounded by nothing (only ever lives inside a three's freed[]).
   'dormant' = a token that should be grounded but isn't (e.g. a gifted three lacking cards).
   Grounded means: 'four' has 4 cards, 'three' has 2 cards. 'freed' is always grounded (needs none). */
function tokenGrounded(t){
  if(t.kind==='freed') return true;
  if(t.kind==='four')  return (t.cards?t.cards.length:0)>=4;
  if(t.kind==='three') return (t.cards?t.cards.length:0)>=2;
  return false;
}
/* colours a player 'has' = each held token's colour PLUS any freed token nested inside a three */
function tokenColors(p){
  const cols=[];
  p.tokens.forEach(t=>{ cols.push(t.color); if(t.kind==='three'&&t.freed&&t.freed[0]) cols.push(t.freed[0].color); });
  return cols;
}
function hasAllSix(p){const s=new Set(tokenColors(p));return NEED_TOKEN_COLORS.every(c=>s.has(c));}
function allGrounded(p){return p.tokens.every(tokenGrounded);}
/* WIN: all six colours present, everything grounded, and holding the winning shape:
   three 3s (each grounded + carrying a freed 4) covering infrared/amber/magenta+teal/green/orange,
   plus one unconverted 4 (the gift) grounded by its 4 cards. */
function hasCompleteSet(p){
  if(!hasAllSix(p)||!allGrounded(p)) return false;
  const threes=p.tokens.filter(t=>t.kind==='three');
  const fours =p.tokens.filter(t=>t.kind==='four');
  return threes.length===3 && fours.length===1
      && threes.every(t=>t.freed&&t.freed[0]);
}
// Individual completion is not victory. Victory requires all three complete simultaneously.
function hasWon(p){return hasCompleteSet(p);}
function playerStatus(p){
  if(p.centered && hasCompleteSet(p)) return "giving";
  if(hasCompleteSet(p)) return "ready for center";
  return "gathering";
}
function updateGivingEligibility(p){
  if(p.centered && !hasCompleteSet(p)){
    p.centered=false;
    p.freed=false;
    log(`<b>${p.name}</b> no longer holds a complete set and returns to gathering.`);
  }
}
function missingColors(p){const s=new Set(tokenColors(p));return NEED_TOKEN_COLORS.filter(c=>!s.has(c));}
function dormantCount(p){return p.tokens.filter(t=>!tokenGrounded(t)).length;}

const SUIT_SUPPLY={hearts:13,spades:13,diamonds:13,clubs:13};
/* count how many cards of each suit are currently LOCKED across all players'
   grounded tokens (a grounded token's cards are locked; freed tokens carry none). */
function lockedBySuit(){
  const c={hearts:0,spades:0,diamonds:0,clubs:0};
  players.forEach(p=>p.tokens.forEach(t=>{
    if(t.kind==='freed') return;
    if(tokenGrounded(t)) (t.cards||[]).forEach(cd=>{ if(c[cd.suit]!==undefined) c[cd.suit]++; });
  }));
  return c;
}
function circulatingBySuit(){
  const locked=lockedBySuit();
  return {hearts:SUIT_SUPPLY.hearts-locked.hearts, spades:SUIT_SUPPLY.spades-locked.spades, diamonds:SUIT_SUPPLY.diamonds-locked.diamonds, clubs:SUIT_SUPPLY.clubs-locked.clubs};
}
/* the two ideal end-bands (as circulating residues): mainstream & mirror */
const IDEAL_MAIN={hearts:11,spades:0,diamonds:0,clubs:11};   // exterior absorbed, interior circulating 11:11
const IDEAL_MIRROR={hearts:0,spades:11,diamonds:11,clubs:0}; // interior absorbed, exterior circulating 11:11
/* distance from current circulating residue to an ideal band (L1, only counting the
   direction that still has to happen: exterior must still be absorbed, etc.) */
function distanceToIdeal(circ, ideal){
  // how far the current locked-state is from the ideal, measured on the exterior/interior axes
  let d=0;
  for(const s of ['hearts','spades','diamonds','clubs']) d+=Math.abs(circ[s]-ideal[s]);
  return d;
}
/* is the triad still ABLE to reach an ideal band? (feasibility: enough of the right
   suits remain uncommitted to complete an exterior- or interior-grounded win) */
function idealReachable(){
  const circ=circulatingBySuit();
  // reachable if neither exterior pair is already over-circulated past the ideal need.
  // mainstream needs spades,diamonds fully absorbed: circulating spades and diamonds must still be reducible to 0
  //   -> feasible while no player has permanently stranded exterior cards loose in won states.
  // We approximate feasibility as: the ideal residue is still >= what's already forced.
  // Simple robust check: an ideal is reachable if current locked doesn't EXCEED it on the
  // 'must stay circulating' suits.
  const locked=lockedBySuit();
  const mainOK = locked.hearts<=SUIT_SUPPLY.hearts-IDEAL_MAIN.hearts && locked.clubs<=SUIT_SUPPLY.clubs-IDEAL_MAIN.clubs;
  const mirrOK = locked.spades<=SUIT_SUPPLY.spades-IDEAL_MIRROR.spades && locked.diamonds<=SUIT_SUPPLY.diamonds-IDEAL_MIRROR.diamonds;
  return {main:mainOK, mirror:mirrOK, any:mainOK||mirrOK};
}
/* an overall 'health' 0..1 of how close/open the ideal still is (for the green->amber->red slide) */
function idealHealth(){
  const circ=circulatingBySuit();
  const dMain=distanceToIdeal(circ,IDEAL_MAIN);
  const dMir=distanceToIdeal(circ,IDEAL_MIRROR);
  const best=Math.min(dMain,dMir);
  const reach=idealReachable();
  if(!reach.any) return {health:0, best, onPath:false};
  // max L1 distance ~ 44 (all wrong). Map to 0..1 (closer = healthier).
  const health=Math.max(0, 1 - best/44);
  const onPath = best<=8 && reach.any; // within the tight ideal band
  return {health, best, onPath, dMain, dMir, reach, circ};
}


function multisets(items,k){const r=[];(function rec(s,c){if(c.length===k){r.push(c.slice());return;}for(let i=s;i<items.length;i++){c.push(items[i]);rec(i,c);c.pop();}})(0,[]);return r;}

function buildPerspective(){const d=[];for(const s of SUITS)for(const[c,n]of Object.entries(SUIT_COLOR_COUNTS))for(let i=0;i<n;i++)d.push({type:"perspective",suit:s,color:c,id:`${s}-${c}-${i}`});return d;}
function buildEssentials(){
  // Each essential COLOUR has a set of iterations (from CONSTELLATIONS). Each 4-colour
  // has 4 iterations, each 3-colour has 3 — so one essential card per iteration.
  const es=[];let idx=0;
  for(const color of Object.keys(ESSENTIAL_COLORS)){
    const iters=CONSTELLATIONS[color];
    const is4=FOUR_COLORS.includes(color);
    iters.forEach(it=>{
      es.push({type:"essential",color,enum:idx,grantsToken:color,realised:false,
        gate: is4 ? {cards:4, suits:it.slice()}
                  : {cards:2, suits:it.cards.slice(), fromFour:it.from}});
      idx++;
    });
  }
  es.push({type:"essential",color:"rainbow",enum:idx,grantsToken:"rainbow",realised:false,gate:{everyColor:true}});
  return es;
}
function reqLabel(g){
  if(g.everyColor) return "◉ all";
  const m={};g.suits.forEach(s=>m[s]=(m[s]||0)+1);
  let s=Object.entries(m).map(([s,n])=>`${n}${GLY[s]}`).join("");
  if(g.fromFour) s+=`+${catMark(g.fromFour)}`;
  return s;
}

/* board: 9x9, 74 filled, essentials spiral inward, perspective outward */
/* ============================================================
   EDITABLE BOARD GEOMETRY
   ------------------------------------------------------------
   To correct the board against your physical one, edit PLACEMENT below.
   - Grid is ROWS x COLS. Essentials span 2 rows (they render 2x tall).
   - Each essential: {n, row, col}. Move it by changing row/col.
   - Perspective cards fill remaining cells; you can pin any of them with
     an entry in PERSPECTIVE_PINS (optional) — otherwise they cluster by
     neighbourhood around the essentials they feed.
   - "Grid made round": any cell not placed stays empty (rounded perimeter).
   Nothing else in the engine needs editing to move cards — layout() reads this.
   ============================================================ */
const ROWS=15, COLS=9;

// ESSENTIALS — seed from a clean counter-clockwise inward spiral (IT->I->WE->ITS),
// quadrant-organised. Positions are APPROXIMATE — correct row/col against your board.
const PLACEMENT = [
  {n:0,  row:2,  col:6},   // teal — IT, "the beginning"
  {n:1,  row:1,  col:4},   // teal — I/IT line, top-center
  {n:2,  row:2,  col:2},   // teal — I, upper-left
  {n:3,  row:4,  col:1},   // green — WE-ward left
  {n:4,  row:6,  col:1},   // green — WE, mid-left
  {n:5,  row:8,  col:1},   // green — WE, lower-left
  {n:6,  row:10, col:3},   // green — WE/ITS bottom
  {n:7,  row:11, col:4},   // green — bottom-center
  {n:8,  row:10, col:5},   // orange — ITS, lower-right
  {n:9,  row:9,  col:7},   // orange — ITS, right
  {n:10, row:6,  col:7},   // orange — ITS/IT, mid-right
  {n:11, row:4,  col:6},   // orange — IT, starts 2nd rotation, below 0
  {n:12, row:4,  col:4},   // magenta — inner top
  {n:13, row:3,  col:3},   // magenta — inner upper-left
  {n:14, row:5,  col:2},   // magenta — inner left
  {n:15, row:7,  col:2},   // infrared — inner left-low
  {n:16, row:8,  col:3},   // infrared — inner low
  {n:17, row:8,  col:6},   // infrared — shifted right to avoid center overlap
  {n:18, row:8,  col:5},   // amber — inner low-right
  {n:19, row:6,  col:5},   // amber — inner right
  {n:20, row:6,  col:4},   // amber — shifted down to clear XII
  {n:21, row:8,  col:4},   // rainbow — CENTER, shifted down one row
];

// OPTIONAL: pin specific perspective cards to specific cells. Leave empty to let
// the engine cluster them by neighbourhood around the essentials they feed.
// Each pin: {suit:"I|IT|ITS|WE", color:"magenta|red|...", row, col}
const PERSPECTIVE_PINS = [];

let board=[];
const CENTER=(()=>{const c=PLACEMENT.find(p=>p.n===21);return {r:c.row,c:c.col};})();

/* which suits feed each essential colour (for neighbourhood clustering of perspective cards) */
function feederSuitsFor(color){
  const iters=CONSTELLATIONS[color]; if(!iters) return [];
  const suits=new Set();
  iters.forEach(it=>{ (Array.isArray(it)?it:it.cards).forEach(s=>suits.add(s)); });
  return [...suits];
}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

function layout(){
  const grid=Array.from({length:ROWS},()=>Array(COLS).fill(undefined)); // undefined = free
  const ess=buildEssentials();
  const essByNum={}; ess.forEach(e=>{ if(!essByNum[e.color])essByNum[e.color]=[]; });
  // essentials are 22 cards but PLACEMENT has 22 slots keyed by enum n (0..21).
  // buildEssentials returns them in enum order, so ess[n] matches PLACEMENT n.
  // place each essential at its (row,col), occupying that cell + the cell below (2 tall).
  const essOccupied=new Set();
  PLACEMENT.forEach(p=>{
    const e=ess[p.n];
    if(!e) return;
    if(grid[p.row][p.col]!==undefined || (p.row+1<ROWS && grid[p.row+1][p.col]!==undefined)) throw new Error(`Overlapping essential at ${p.n} (${p.row},${p.col})`);
    grid[p.row][p.col]=e;
    essOccupied.add(p.row+','+p.col);
    if(p.row+1<ROWS){ grid[p.row+1][p.col]='BELOW'; essOccupied.add((p.row+1)+','+p.col); } // 2-tall marker
  });
  // perspective cards: cluster near essentials that need their suit.
  const persp=shuffle(buildPerspective());
  // build a preference list of free cells near feeder essentials for each suit
  const freeCells=[];
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(grid[r][c]===undefined) freeCells.push({r,c});
  }
  // score each free cell by nearest essential whose colour is fed by a given suit
  function nearestEssentialDistForSuit(cell,suit){
    let best=1e9;
    PLACEMENT.forEach(p=>{
      const e=ess[p.n]; if(!e||e.color==='rainbow')return;
      if(feederSuitsFor(e.color).includes(suit)){
        const d=Math.abs(p.row-cell.r)+Math.abs(p.col-cell.c);
        if(d<best)best=d;
      }
    });
    return best;
  }
  // greedily place each perspective card in the nearest free cell to its suit's essentials
  const pinnedCells=new Set();
  PERSPECTIVE_PINS.forEach(pin=>{ if(grid[pin.row] && grid[pin.row][pin.col]===undefined){ grid[pin.row][pin.col]={type:"perspective",suit:pin.suit,color:pin.color}; pinnedCells.add(pin.row+','+pin.col); }});
  for(const card of persp){
    // find the free cell minimizing distance to this suit's feeder-essentials
    let bestCell=null,bestD=1e9;
    for(const cell of freeCells){
      const key=cell.r+','+cell.c;
      if(grid[cell.r][cell.c]!==undefined) continue;
      const d=nearestEssentialDistForSuit(cell,card.suit) + Math.random()*0.5;
      if(d<bestD){bestD=d;bestCell=cell;}
    }
    if(bestCell){ grid[bestCell.r][bestCell.c]=card; }
  }
  // finalize: undefined & 'BELOW' -> handled in render; convert undefined leftover to null (empty)
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(grid[r][c]===undefined) grid[r][c]=null;
  }
  board=grid;
}

/* players (triad)
   State model:
   - hand: loose reserved cards {suit,color} — working material, not yet spent into a token
   - tokens: [{color, backed}] — backed=true means grounded by its constellation of suit-cards
   - reserves: {r,c} board spaces this player has claimed (for the anti-monopoly board marking)
   Collection binds cards into tokens (removed from hand). At the turning point, holdings
   free — but a gifted token arrives backed:false and only counts once the receiver holds
   matching suit-cards. Win = all six colours + one gift, every token backed. */
const PC=["#3c6e63","#b5642e","#7a5bc7"];
let players=[];
function initPlayers(){
  const wantCorners=[{r:0,c:0},{r:0,c:COLS-1},{r:ROWS-1,c:Math.floor(COLS/2)}];
  const corners=wantCorners.map(corner=>{
    // nearest populated, landable cell to this corner
    let best=null,bd=1e9;
    for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
      const v=board[r]&&board[r][c];
      if(!v||v==='BELOW')continue;
      const d=Math.abs(r-corner.r)+Math.abs(c-corner.c);
      if(d<bd){bd=d;best={r,c};}
    }
    return best||{r:0,c:0};
  });
  players=[0,1,2].map(i=>({id:i,name:["A","B","C"][i],color:PC[i],pos:{...corners[i]},
    hand:[], tokens:[], reserves:[],
    centered:false, freed:false}));
}
/* the constellation each essential colour requires (for grounding gifted dormant tokens) */
function tokenConstellation(color){
  const sample=buildEssentials().find(e=>e.grantsToken===color);
  return sample && sample.gate.suits ? sample.gate.suits : [];
}


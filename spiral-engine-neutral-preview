function openSettings(){renderCalibration();showPage("calibration");}
document.getElementById('recalBtn').onclick=openSettings;
document.getElementById('gameSettings').onclick=openSettings;
document.getElementById('welcomeNext').onclick=()=>showPage("calibration");
document.getElementById('settingsBack').onclick=()=>showPage(board.length?"game":"welcome");
document.getElementById('settingsStart').onclick=startGame;

document.getElementById('splitToggle').onclick=()=>{
  const el=document.getElementById('idealSplit');
  const opening=el.style.display==='none';
  el.style.display=opening?'block':'none';
  document.getElementById('splitToggle').textContent=opening?'hide suit totals ▴':'show suit totals ▾';
  renderIllumination();
};
/* boot */
renderCalibration();
</script>

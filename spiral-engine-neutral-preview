function moveTo(r,c){
  const me=players[turn];
  const resolved=cardAt(r,c);
  me.pos={r:resolved.r,c:resolved.c}; awaitingMove=false;
  const card=resolved.card;
  if(playerStatus(me)==='giving') arriveGiving(resolved.r,resolved.c,card);
  else arriveGathering(card,me);
  renderBoard();renderPlayers();renderPhase();renderIllumination();
}

/* ---- INHALE ---- */
function arriveGathering(card,me){
  if(card.type==='perspective'){
    const claimed=reservedBy(me.pos.r,me.pos.c);
    if(claimed){ // someone already reserved this space
      showAction(`<div class="rmeta">already reserved by ${claimed.name}</div>
        <div class="hint">This card is out of play — its space is claimed. Nothing to reserve here.</div>
        <button class="btn ghost" onclick="endTurn()">End turn</button>`);
      return;
    }
    showAction(`<div class="rmeta"><span class="rcolor" style="background:${fill(card.color)}"></span>${GLY[card.suit]} · ${cat(card.color)}</div>
      ${optionalQuestion(CONTENT.perspectiveQuestions[card.id])}
      <div class="hint">Reserve this card. It stays with you until you bind or give it.</div>
      <button class="btn" onclick="reserveHere()">Reserve &amp; end turn</button>`);
  }else{
    realiseCheck(card,me);
  }
}
window.reserveHere=function(){
  const me=players[turn];const card=board[me.pos.r][me.pos.c];
  me.reserves.push({r:me.pos.r,c:me.pos.c});
  me.hand.push({suit:card.suit,color:card.color}); // loose working card
  log(`<b >${me.name}</b> reserved ${GLY[card.suit]} <span style="color:var(--ink-faint)">${cat(card.color)}</span>`);
